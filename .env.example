# Copy this file to .env for local development. Never commit real credentials.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=videoagent
MYSQL_USER=videoagent
MYSQL_PASSWORD=change-me-app-password
MYSQL_PORT=3306

REDIS_HOST=localhost
REDIS_PORT=6380

MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_UPLOAD_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=videoagent
VIDEO_PLAYBACK_PRESIGN_TTL=60m
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_UPLOAD_GATEWAY_PORT=9002
UPLOAD_MAX_CONNECTIONS_PER_IP=6
UPLOAD_MAX_CONNECTIONS_GLOBAL=100
UPLOAD_REQUEST_RATE_PER_IP=20r/s
UPLOAD_REQUEST_BURST=40

VIDEO_MAX_FILE_SIZE=500MB
VIDEO_MAX_REQUEST_SIZE=501MB
VIDEO_UPLOAD_COMPLETION_TIMEOUT=30m
VIDEO_UPLOAD_COMPLETION_RECOVERY_INTERVAL_MS=30000

JWT_SECRET=
JWT_EXPIRATION=2h

ROCKETMQ_NAMESRV_ADDR=localhost:9876
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_FAST_REMAP_PORT=10909
ROCKETMQ_SEND_TIMEOUT=3000
VIDEO_ANALYZE_TOPIC=VIDEO_ANALYZE_TOPIC
VIDEO_ANALYZE_CONSUMER_GROUP=videoagent-analysis-consumer

VIDEO_ANALYSIS_TYPE=STRUCTURED_SUMMARY
VIDEO_ANALYSIS_MODEL_VERSION=m5-langchain4j-structured-v1
VIDEO_ANALYSIS_PROGRESS_TTL=24h
VIDEO_ANALYSIS_SSE_TIMEOUT=30m
# Product support limit for AI analysis; uploads remain allowed above this duration.
ANALYSIS_MAX_VIDEO_DURATION=60m
ANALYSIS_MAX_ACTIVE_PER_USER=3
ANALYSIS_RATE_LIMIT_CAPACITY=60
ANALYSIS_RATE_LIMIT_REFILL_TOKENS=10
ANALYSIS_RATE_LIMIT_REFILL_PERIOD=1s
ANALYSIS_RATE_LIMIT_COST_PER_REQUEST=1

# M7 reliability
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_PROCESSING_LEASE=15m
ANALYSIS_HEARTBEAT_INTERVAL=2m
ANALYSIS_RECOVERY_INTERVAL_MS=30000
OUTBOX_PUBLISH_INTERVAL=5000
OUTBOX_INITIAL_BACKOFF=5s
OUTBOX_BACKOFF_MULTIPLIER=2
OUTBOX_MAX_ATTEMPTS=15
OUTBOX_BATCH_SIZE=20

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT=30s
FFMPEG_STDERR_MAX_CHARS=4000
MEDIA_TEMP_ROOT=../tmp/videoagent-media

ASR_PROVIDER=mock
ASR_API_KEY=
ASR_MODEL=fun-asr-flash-2026-06-15
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ASR_TIMEOUT=60s
# Optional DashScope language hints; leave empty for provider auto-detection.
ASR_LANGUAGE_HINTS=

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60s
LLM_MAX_RETRIES=1
LLM_STRUCTURED_OUTPUT_MODE=json_object
# Application-level conservative budget based on current V1 capacity characterization.
LLM_MAX_USER_PROMPT_CHARS=50000

# ============================================
# M8.1 RAG — Adaptive Basic RAG
# ============================================
# Engineering defaults, not theoretically optimal parameters.

RAG_DIRECT_CONTEXT_MAX_CHARS=8000
RAG_CHUNK_MAX_CHARS=2000
RAG_CHUNK_OVERLAP_SEGMENTS=1
RAG_DENSE_TOP_K=15
RAG_DENSE_MINIMUM_SCORE=0.0
RAG_LEXICAL_TOP_K=15
RAG_RRF_K=60
RAG_RRF_CANDIDATE_LIMIT=15
RAG_FINAL_EVIDENCE_LIMIT=5
RAG_RERANKER_ENABLED=false
RAG_RERANKER_BASE_URL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=
RAG_RERANKER_TIMEOUT=3s

MILVUS_URI=http://localhost:19530
MILVUS_PORT=19530
MILVUS_WEBUI_PORT=9091
MILVUS_TOKEN=
MILVUS_COLLECTION=video_transcript_chunks
MILVUS_TIMEOUT=10s

# Full local demo uses DashScope's OpenAI-compatible text embedding API.
# Tests continue to select the mock provider explicitly.
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT=30s

# ============================================
# M8.2 Agentic Retrieval
# ============================================
AGENT_PLANNER_PROVIDER=mock
AGENT_MAX_TOOL_CALLS=4
AGENT_TIME_LOOKUP_WINDOW_MS=15000
AGENT_MAX_TIME_WINDOW_MS=120000
AGENT_MAX_EVIDENCE_ITEMS=12
AGENT_MAX_EVIDENCE_CHARS=12000
AGENT_PLANNER_MODEL=
