# Copy this file to .env for local development. Never commit real credentials.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=videoagent
MYSQL_USER=videoagent
MYSQL_PASSWORD=change-me-app-password
MYSQL_PORT=3306

REDIS_HOST=localhost
REDIS_PORT=6380

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me-minio-access-key
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=videoagent
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

VIDEO_MAX_FILE_SIZE=500MB
VIDEO_MAX_REQUEST_SIZE=501MB

JWT_SECRET=
JWT_EXPIRATION=2h

ROCKETMQ_NAMESRV_ADDR=localhost:9876
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_FAST_REMAP_PORT=10909
ROCKETMQ_SEND_TIMEOUT=3000
VIDEO_ANALYZE_TOPIC=VIDEO_ANALYZE_TOPIC
VIDEO_ANALYZE_CONSUMER_GROUP=videoagent-analysis-consumer

VIDEO_ANALYSIS_TYPE=STRUCTURED_SUMMARY
VIDEO_ANALYSIS_MODEL_VERSION=m5-langchain4j-structured-v1
VIDEO_ANALYSIS_PROGRESS_TTL=24h
VIDEO_ANALYSIS_SSE_TIMEOUT=30m

# M7 reliability
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_PROCESSING_LEASE=15m
ANALYSIS_HEARTBEAT_INTERVAL=2m
ANALYSIS_HEARTBEAT_INTERVAL_MS=120000
ANALYSIS_RECOVERY_INTERVAL_MS=30000
OUTBOX_PUBLISH_INTERVAL=5000
OUTBOX_INITIAL_BACKOFF=5s
OUTBOX_BACKOFF_MULTIPLIER=2
OUTBOX_MAX_ATTEMPTS=15
OUTBOX_BATCH_SIZE=20

FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT=30s
FFMPEG_STDERR_MAX_CHARS=4000
MEDIA_TEMP_ROOT=../tmp/videoagent-media

ASR_PROVIDER=mock
ASR_API_KEY=
ASR_MODEL=fun-asr-flash-2026-06-15
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
ASR_TIMEOUT=60s

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=60s
LLM_MAX_RETRIES=1
LLM_STRUCTURED_OUTPUT_MODE=json_object

# ============================================
# M8.1 RAG — Adaptive Basic RAG
# ============================================
# Engineering defaults, not theoretically optimal parameters.

RAG_DIRECT_CONTEXT_MAX_CHARS=8000
RAG_CHUNK_MAX_CHARS=2000
RAG_CHUNK_OVERLAP_SEGMENTS=1
RAG_TOP_K=5

QDRANT_HOST=localhost
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=video_transcript_chunks

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=384
EMBEDDING_TIMEOUT=30s

# ============================================
# M8.2 Agentic Retrieval
# ============================================
AGENT_PLANNER_PROVIDER=mock
AGENT_MAX_TOOL_CALLS=4
AGENT_TIME_LOOKUP_WINDOW_MS=15000
AGENT_MAX_TIME_WINDOW_MS=120000
AGENT_MAX_EVIDENCE_ITEMS=12
AGENT_MAX_EVIDENCE_CHARS=12000
AGENT_PLANNER_MODEL=
